generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique // used by the CLI to target this project
  createdAt     DateTime       @default(now())
  builds        Build[]
  keystore      Keystore?
  notifications Notification[]
}

model Build {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  status       String // queued | running | success | failed | canceled
  platform     String    @default("android")
  buildType    String    @default("apk") // apk | aab | update (OTA-only, skips Gradle)
  profile      String    @default("release") // release | debug
  abi          String    @default("arm64-v8a") // comma-separated ABI list to compile
  ota          Boolean   @default(false) // also export an OTA bundle alongside the apk/aab
  tarballPath  String // path on the uploads volume
  artifactPath String? // path on the artifacts volume
  logPath      String? // full log file on the artifacts volume
  sizeBytes    Int?
  error        String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  // --- app identity, read from `expo config` during the build ---
  versionName    String? // expo.version, e.g. "1.4.0"
  versionCode    Int? // expo.android.versionCode — what the APK channel compares
  androidPackage String? // expo.android.package
  // The OTA compatibility key. An update is only ever served to an installed
  // app reporting the SAME runtimeVersion, which is what stops a JS bundle
  // from landing on a binary that lacks the native code it needs.
  runtimeVersion String?

  // --- OTA payload (expo export output), when this build produced one ---
  updateDirPath String? // /data/artifacts/<id>/update
  updateUuid    String? // the expo manifest `id` — must be a UUID, not a cuid

  // Release switches. Two flags, not one: a `--ota` build carries both an APK
  // and an update bundle, and promoting a later OTA-only build must not also
  // retire that build's APK from /api/apps/<slug>/latest.
  channel        String  @default("production")
  releasedApk    Boolean @default(false) // serves /api/apps/<slug>/latest
  releasedUpdate Boolean @default(false) // serves the OTA manifest endpoint

  @@index([projectId, channel])
}

/// A message the dashboard sends to installed apps.
///
/// This is a *pull* channel, not push: there is no device registry and nothing
/// is ever sent to a phone. Apps poll GET /api/notifications/<slug>, so the
/// server never learns who installed it, and nothing here needs Firebase, a
/// device token, or a native module in the app.
model Notification {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  title   String
  body    String
  /// Optional "learn more" target. Opened in the system browser by the app,
  /// so it must be http(s) — the app refuses anything else.
  linkUrl String?
  /// info | warning — the app colours the banner from this and nothing more.
  level   String  @default("info")

  /// Matches the release channel the app is on, so a beta announcement never
  /// reaches production installs.
  channel String @default("production")

  createdAt DateTime  @default(now())
  /// After this instant the app stops showing it. Null means it stays until
  /// retracted or aged out of the served window.
  expiresAt DateTime?
  /// The retract switch. Kept rather than deleted so the dashboard can still
  /// show what was sent — but apps stop serving it immediately.
  active    Boolean   @default(true)

  @@index([projectId, channel, active])
}

// Phase 2 — present in the schema so the DB never needs a breaking migration,
// but no code touches it in Phase 0.
model Keystore {
  id            String  @id @default(cuid())
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id])
  path          String // .jks/.keystore file on a volume
  keyAlias      String
  storePassword String // plaintext acceptable for localhost-only; MUST stay out of git & logs
  keyPassword   String
}
